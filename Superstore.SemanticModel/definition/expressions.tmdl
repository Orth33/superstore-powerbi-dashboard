/// Local source-file parameter. Change this value if the project is moved.
expression SourceFilePath = "E:\Borderless-Work\Mini Project\Superstore-PowerBI\Data\Superstore.csv" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: f47e219c-c5c6-4d82-8e72-ad2ee5816262

	annotation PBI_ResultType = Text

/// Shared typed and cleaned source query used by all model tables.
expression SuperstoreSource =
		let
			Source = Csv.Document(File.Contents(SourceFilePath), [Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			TrimmedHeaders = Table.TransformColumnNames(PromotedHeaders, each Text.Trim(_)),
			TypedColumns = Table.TransformColumnTypes(TrimmedHeaders, {
				{"Row ID", Int64.Type}, {"Order ID", type text}, {"Order Date", type date}, {"Ship Date", type date},
				{"Ship Mode", type text}, {"Customer ID", type text}, {"Customer Name", type text}, {"Segment", type text},
				{"Country", type text}, {"City", type text}, {"State", type text}, {"Postal Code", type text}, {"Region", type text},
				{"Product ID", type text}, {"Category", type text}, {"Sub-Category", type text}, {"Product Name", type text},
				{"Sales", Currency.Type}, {"Quantity", Int64.Type}, {"Discount", Decimal.Type}, {"Profit", Currency.Type}
			}, "en-US"),
			TrimmedText = Table.TransformColumns(TypedColumns, {
				{"Order ID", Text.Trim, type text}, {"Ship Mode", Text.Trim, type text}, {"Customer ID", Text.Trim, type text},
				{"Customer Name", Text.Trim, type text}, {"Segment", Text.Trim, type text}, {"Country", Text.Trim, type text},
				{"City", Text.Trim, type text}, {"State", Text.Trim, type text}, {"Postal Code", Text.Trim, type text},
				{"Region", Text.Trim, type text}, {"Product ID", Text.Trim, type text}, {"Category", Text.Trim, type text},
				{"Sub-Category", Text.Trim, type text}, {"Product Name", Text.Trim, type text}
			}),
			PaddedPostalCodes = Table.TransformColumns(TrimmedText, {{"Postal Code", each Text.PadStart(_, 5, "0"), type text}})
		in
			PaddedPostalCodes
	lineageTag: 0e3affb7-2a5a-4988-ac24-9a1e7aaa1266

